# PostgreSQL On-Premise
DATABASE_URL=postgresql://kc_account:CHANGE_ME@postgres:5432/kc_account
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# One-time, idempotent normalized accounting bootstrap
KC_BOOTSTRAP_ADMIN_EMAIL=finance.admin@example.com
KC_BOOTSTRAP_TENANT_CODE=KC
KC_BOOTSTRAP_TENANT_NAME=KC Group
KC_BOOTSTRAP_COMPANY_CODE=COMPANY-001
KC_BOOTSTRAP_COMPANY_NAME=Configure company legal name
KC_BOOTSTRAP_TAX_ID=
KC_BOOTSTRAP_FISCAL_YEAR=2026

# Backup destination mounted on the host; never commit generated archives.
KC_BACKUP_DIR=/var/backups/kc-account-360

# OIDC/OAuth2 Proxy. Never expose the app container directly when enabled.
AUTH_TRUST_PROXY=true
OIDC_ISSUER_URL=https://identity.example.com/realms/kc
OIDC_CLIENT_ID=kc-account-360
OIDC_CLIENT_SECRET=CHANGE_ME
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME_32_BYTE_BASE64
OAUTH2_PROXY_COOKIE_SECURE=true

# Outbound integrations (keep empty until configured in the target environment)
KC_CUTO_OUTBOUND_TOKEN=
KC_TORY_OUTBOUND_TOKEN=
KC_EAM_OUTBOUND_TOKEN=
KC_HR_OUTBOUND_TOKEN=
KC_INTEGRATION_ALLOWED_HOSTS=
